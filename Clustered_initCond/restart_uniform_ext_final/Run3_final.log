
units           real
boundary p p p
atom_style      full

read_restart final_state_Run3_ext.restart
  restoring atom style full from restart
  orthogonal box = (-420 -420 -420) to (420 420 420)
  2 by 2 by 7 MPI processor grid
  restoring pair style lj/cut from restart
  restoring bond style hybrid from restart
  restoring angle style cosine from restart
  14000 atoms
  15406 bonds
  13600 angles
  3 = max # of 1-2 neighbors
  4 = max # of 1-3 neighbors
  8 = max # of 1-4 neighbors
  56 = max # of special neighbors
  special bonds CPU = 0.624275 secs
  read_restart CPU = 0.721695 secs
mass 1 100
mass 2 100
mass 3 100
mass 4 100

neighbor 1.9 bin
neigh_modify every 1 delay 1 check yes

angle_style  cosine
angle_coeff   *  2  # K (energy unit)

bond_style 		hybrid harmonic harmonic/shift/cut
bond_coeff   1   harmonic 3   10
bond_coeff   2   harmonic 3   10
bond_coeff	3	harmonic/shift/cut 3.60	11.22	12.72

pair_style lj/cut 25
# atom-typ1, atom-typ2, energy-well, sigma (bead-diameter), cut-off (distance)
pair_coeff  * * 0.18 10 25

special_bonds lj  0 1 1 angle yes
  3 = max # of 1-2 neighbors
  4 = max # of 1-3 neighbors
  8 = max # of 1-4 neighbors
  40048 = # of 1-3 neighbors before angle trim
  27200 = # of 1-3 neighbors after angle trim
  56 = max # of special neighbors
  special bonds CPU = 0.00183801 secs

# further equilibriate the system before bond formation takes place
fix fxlan all langevin $T $T 1000 ${seed}
fix fxlan all langevin 310 $T 1000 ${seed}
fix fxlan all langevin 310 310 1000 ${seed}
fix fxlan all langevin 310 310 1000 61776
fix fxnve all nve
timestep 0.1
run 10000
