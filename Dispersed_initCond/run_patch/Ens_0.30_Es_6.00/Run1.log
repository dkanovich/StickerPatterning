dump coor all custom 10000000 traj_Run1.dump id type mol mass x y z xu yu zu

restart ${dt_restart} ${fName}_tp_*.restart
restart 50000000 ${fName}_tp_*.restart
restart 50000000 Run1_tp_*.restart
run ${steps}
