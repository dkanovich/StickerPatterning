fix fxlan all langevin 310 $T 1000 ${seed}
fix fxlan all langevin 310 310 1000 ${seed}
fix fxlan all langevin 310 310 1000 87835
fix fxnve all nve

comm_style tiled
fix fxbal all balance 1000 1.1 rcb

timestep 25

dump coor all custom ${dt_movie} traj_${fName}.dump id type mol mass x y z xu yu zu
dump coor all custom 10000000 traj_${fName}.dump id type mol mass x y z xu yu zu
dump coor all custom 10000000 traj_Run4.dump id type mol mass x y z xu yu zu

restart ${dt_restart} ${fName}_tp_*.restart
restart 50000000 ${fName}_tp_*.restart
restart 50000000 Run4_tp_*.restart
run ${steps}
