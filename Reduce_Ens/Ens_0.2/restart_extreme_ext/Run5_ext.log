# further equilibriate the system before bond formation takes place
fix fxlan all langevin $T $T 500 ${seed}
fix fxlan all langevin 310 $T 500 ${seed}
fix fxlan all langevin 310 310 500 ${seed}
fix fxlan all langevin 310 310 500 20059
fix fxnve all nve
timestep 0.1
run 10000
